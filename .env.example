# CertWatch — example environment configuration (technical specification Section 24).
# Copy to .env for local development: cp .env.example .env
# Every value here is server-side config, never client-controlled input.

APP_NAME=CertWatch
ENVIRONMENT=development

# --- Scan submission limits ---
MAX_HOSTS_PER_SCAN=250
SUBMIT_RATE_LIMIT_PER_IP_PER_HOUR=5

# --- Network/scanning timeouts and concurrency (consumed by M2, declared now) ---
SCAN_CONNECT_TIMEOUT_SECONDS=3
SCAN_HANDSHAKE_TIMEOUT_SECONDS=2
SCAN_CONCURRENCY_PER_SCAN=15
SCAN_CONCURRENCY_GLOBAL=100
SCAN_TOTAL_TIMEOUT_SECONDS=180

# --- Allowed scan ports (fixed allowlist — never arbitrary) ---
ALLOWED_SCAN_PORTS=443,8443,993,995

# --- AI / /ask (Section 16/17, M7) ---
# Rate limiting (ASK_RATE_LIMIT_*) is declared here but not yet enforced —
# that's M8's job (Decision Log). AI_ENABLED_BY_DEFAULT is the per-scan
# toggle's default; leave LLM_API_KEY unset to run /ask with no real LLM
# calls at all — it returns a plain fallback message, not an error.
ASK_RATE_LIMIT_PER_SCAN=20
ASK_RATE_LIMIT_PER_IP_PER_HOUR=60
AI_ENABLED_BY_DEFAULT=true
# LLM_API_KEY=            # never commit a real key
# LLM_MODEL=claude-sonnet-4-5-20250929   # optional override of the default model

# --- Data retention ---
DEFAULT_RETENTION_DAYS=90

# --- Object storage ---
# "local" is the only implemented backend at M0. Cloud provider selection is an
# explicit M2 gate — do not set this to s3/azure_blob/r2 before that decision
# is made and recorded in the Decision Log.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=./.data/scans
